# Frontend build-time configuration (Vite). Copy to `.env` for local dev.
# These are baked into the build, so set them in CI / the deploy environment.

# Optional. API origin. Leave unset for same-origin (backend serves this SPA).
# VITE_API_URL=https://api.example.com/api

# Optional. Set to enable Clerk auth (Clerk dashboard → API Keys → Publishable key).
# Must be paired with CLERK_SECRET_KEY on the backend. When unset, the app uses
# the built-in JWT login.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
