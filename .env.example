# Root environment file for docker compose. Copy to `.env` and fill in.
#   cp .env.example .env

# REQUIRED. Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   (or: openssl rand -hex 48)
JWT_SECRET=

# Optional. Comma-separated allowed CORS origins. Leave blank for same-origin
# (the default single-service setup serves the SPA and API together).
# CORS_ORIGINS=https://crm.example.com

# Optional. Cloudflare Tunnel token — only needed for the `tunnel` profile:
#   docker compose --profile tunnel up -d
# TUNNEL_TOKEN=
