# Root environment file for docker compose. Copy to `.env` and fill in.
#   cp .env.example .env

# Auth: provide EITHER the built-in JWT secret OR Clerk keys (not both needed).

# Built-in auth. Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   (or: openssl rand -hex 48)
JWT_SECRET=

# Clerk auth (multi-tenant organizations). When set, JWT_SECRET is unused.
#   CLERK_SECRET_KEY            — backend (Clerk dashboard → API Keys → Secret key)
#   VITE_CLERK_PUBLISHABLE_KEY  — frontend, baked in at build time (Publishable key)
# CLERK_SECRET_KEY=sk_live_xxx
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxx

# Optional. Comma-separated allowed CORS origins. Leave blank for same-origin
# (the default single-service setup serves the SPA and API together).
# CORS_ORIGINS=https://crm.example.com

# Optional. Cloudflare Tunnel token — only needed for the `tunnel` profile:
#   docker compose --profile tunnel up -d
# TUNNEL_TOKEN=
