# ── LogiCRM backend configuration ───────────────────────────────────────────
# Copy to `.env` and fill in. In production every value below should be set.

# Node environment: "development" (default) or "production".
NODE_ENV=development

# HTTP port the Express server listens on.
PORT=3001

# Auth provider selection:
#  • Leave CLERK_SECRET_KEY blank to use the built-in JWT auth (set JWT_SECRET).
#  • Set CLERK_SECRET_KEY to delegate auth to Clerk (multi-tenant organizations);
#    JWT_SECRET is then unused.

# REQUIRED in production when NOT using Clerk. Random string used to sign JWTs.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set to enable Clerk auth (from the Clerk dashboard → API Keys → Secret key).
# The matching frontend key is VITE_CLERK_PUBLISHABLE_KEY (set at build time).
# CLERK_SECRET_KEY=sk_test_xxx

# Optional. Override the SQLite database file location.
# DB_PATH=/var/lib/logicrm/crm.db

# Optional. Comma-separated list of allowed CORS origins (production only).
# Leave blank to allow same-origin requests served by this process.
# CORS_ORIGINS=https://crm.freightclause.com
