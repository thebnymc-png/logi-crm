# ── LogiCRM backend configuration ───────────────────────────────────────────
# Copy to `.env` and fill in. In production every value below should be set.

# Node environment: "development" (default) or "production".
NODE_ENV=development

# HTTP port the Express server listens on.
PORT=3001

# REQUIRED in production. Long random string used to sign JWTs.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. Override the SQLite database file location.
# DB_PATH=/var/lib/logicrm/crm.db

# Optional. Comma-separated list of allowed CORS origins (production only).
# Leave blank to allow same-origin requests served by this process.
# CORS_ORIGINS=https://crm.freightclause.com
